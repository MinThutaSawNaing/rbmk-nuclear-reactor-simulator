// Windows shell resources for RBMK-Control-Room.exe.
// Configured from CMakeLists.txt; @RBMK_ICON_FILE@ is the absolute path of the
// multi-resolution icon generated by tools/make_icons.py.
#include <windows.h>

#define IDI_APPICON 101

IDI_APPICON ICON "@RBMK_ICON_FILE@"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION     @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 PRODUCTVERSION  @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
 FILEFLAGS       0
 FILEOS          VOS_NT_WINDOWS32
 FILETYPE        VFT_APP
 FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "RBMK Simulation"
            VALUE "FileDescription",  "RBMK-1000 Control Room - nuclear reactor simulator"
            VALUE "FileVersion",      "@PROJECT_VERSION@.0"
            VALUE "InternalName",     "RBMK-Control-Room"
            VALUE "LegalCopyright",   "Copyright (C) RBMK Simulation. All rights reserved."
            VALUE "OriginalFilename", "RBMK-Control-Room.exe"
            VALUE "ProductName",      "RBMK-1000 Control Room"
            VALUE "ProductVersion",   "@PROJECT_VERSION@.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
